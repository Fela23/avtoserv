# Environment variables for Avtoservis Native App

# API Configuration
EXPO_PUBLIC_API_URL=https://api.avtoserv.com
EXPO_PUBLIC_WS_URL=wss://api.avtoserv.com

# Push Notifications (FCM)
EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id

# Deep Linking
EXPO_PUBLIC_SCHEME=avtoservis

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRICS=true
EXPO_PUBLIC_ENABLE_PUSH=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Analytics (optional)
EXPO_PUBLIC_ANALYTICS_ID=

# Sentry DSN (optional)
EXPO_PUBLIC_SENTRY_DSN=
